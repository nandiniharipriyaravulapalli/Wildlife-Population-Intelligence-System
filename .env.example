# ---------- Backend ----------
# Runs the API from the repo root: uvicorn backend.app:app
APP_ENV=development
DATABASE_URL=postgresql://wildlife_app:CHANGE_ME@localhost:5432/wildlife_db
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public address of this API (used to build image links)
PUBLIC_API_URL=http://localhost:8000

# ---------- Frontend (set in frontend/.env or on the host) ----------
VITE_API_URL=http://localhost:8000
